<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="EnterprisePOS"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Inoc;Integrated Security=True;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Sales tax percentage applied at checkout (0-100). -->
		<add key="TaxRatePercent" value="8" />
		<!-- Printed on receipts. -->
		<add key="BusinessName" value="JIMIN-POS" />
		<add key="BusinessAddress" value="123 Main Street, City" />
		<add key="BusinessPhone" value="" />
		<!-- Currency symbol shown on screen and on receipts. -->
		<add key="CurrencySymbol" value="₱" />
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
	</startup>
</configuration>
